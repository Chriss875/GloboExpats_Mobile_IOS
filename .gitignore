# Release build credentials. CLAUDE.md Rule 5 keeps these out of the repo;
# the file lives here only so a release build has one place to read them from.
.env.release
*.env.release

# Generated from `.env.release` by the iOS release helper. These values are
# local signing/service configuration and must never be committed.
/ios/Flutter/Secrets.xcconfig
/ios/Runner/GoogleService-Info.plist
/android/app/google-services.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/
/android/build/

# Local Playwright harness (node_modules is an artifact, not source).
# Campaign V2 REQUIRES evidence in-repo: shots/, videos/, results.jsonl are tracked.
/e2e/node_modules/

# Historical Android verification evidence is kept on the workstation but is
# not part of the iOS source repository. Fresh iOS evidence is generated by CI
# or during release verification rather than pushing gigabytes of recordings.
/e2e/videos/
/e2e/shots/
/e2e/results/
/e2e/reports/
/e2e/results.jsonl

# One-off diagnostic scripts from earlier verify passes (superseded by per-AU
# verify_*.js + lib_verify.js). Kept on disk for forensics, not tracked.
/e2e/tmp/

# Local build/verification markers and one-off captured Android artifacts.
/.last_build_mtime
/.last_build_sha
/w*.png
/x*.png
/wdump*.xml
/skeptic-*.png

# Release signing material — never commit these.
android/key.properties
*.jks
*.keystore
