# Template for `.env.release` (gitignored). Copy to `.env.release` and fill the
# real values — ask the lead for them. `tool/build_ios_release.sh` sources this file
# and REFUSES to build if a required key is missing.
#
# One app, two builds. dev and prod differ only in backend + Matomo target, so
# every key that differs has a `_DEV` and `_PROD` variant. An unsuffixed value
# (where listed) is a legacy fallback and may be dropped once both variants are
# present.

# --- Analytics API (FastAPI) through the existing authenticated web proxy. ---
# Required and flavour-specific; both must use https://.
ANALYTICS_BASE_URL_DEV=https://dev.globoexpats.com/api
ANALYTICS_BASE_URL_PROD=https://globoexpats.com/api
# Legacy fallback used only when the matching value above is unset.
#ANALYTICS_BASE_URL=

# --- Google sign-in Web OAuth client — audience-bound, required per flavour. ---
# The prod build REACHES api.globoexpats.com; if it is built with the dev
# audience its Google sign-in is rejected. Set both.
GOOGLE_SERVER_CLIENT_ID_DEV=
GOOGLE_SERVER_CLIENT_ID_PROD=
# Legacy fallback (pre-split). Only used if the matching _DEV/_PROD value is unset.
#GOOGLE_SERVER_CLIENT_ID=

# --- iOS Google/Firebase configuration ---
# Create an iOS app in the same Firebase project using bundle ID
# `com.globoexpats.marketplace`, then copy its GoogleService-Info.plist to the
# path below. The plist itself stays gitignored. Google login may use a
# different Cloud project from Firebase, and dev/prod backends may expect
# different OAuth audiences, so set each iOS client beside its matching server
# client above. All four values are public OAuth identifiers, not secrets.
FIREBASE_IOS_PLIST_PATH=
GOOGLE_IOS_CLIENT_ID_DEV=
GOOGLE_IOS_REVERSED_CLIENT_ID_DEV=
GOOGLE_IOS_CLIENT_ID_PROD=
GOOGLE_IOS_REVERSED_CLIENT_ID_PROD=
# Legacy fallbacks used only when the matching _DEV/_PROD value is unset.
#GOOGLE_IOS_CLIENT_ID=
#GOOGLE_IOS_REVERSED_CLIENT_ID=

# --- Google Maps / Places — both required for a production iOS build. ---
# Maps: iOS-app restricted to Maps SDK for iOS.
# Places: iOS-app restricted to Places API (New), Geocoding API, and Routes API.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Matomo — per flavour. Dev reports into the DEV Matomo, prod into the LIVE
# Matomo (two separate instances, so the two apps' data can never mix). ---
# dev build  -> matomodev.globoexpats.com, site 2 (app), screen host app-dev.globoexpats.com
# prod build -> matomo.globoexpats.com,     site 2 (app), screen host app.globoexpats.com
# Each instance has its OWN token, so a mismatched pair reports into the wrong
# place or not at all. The script refuses a prod build that resolves to the dev URL.
MATOMO_URL_DEV=https://matomodev.globoexpats.com/index.php
MATOMO_SITE_ID_DEV=2
MATOMO_TOKEN_DEV=

MATOMO_URL_PROD=https://matomo.globoexpats.com/index.php
MATOMO_SITE_ID_PROD=2
MATOMO_TOKEN_PROD=

# Legacy fallback (pre-split). Only used for a flavour whose _DEV/_PROD value is
# unset; a prod build that falls back to the DEV URL is refused.
#MATOMO_URL=
#MATOMO_SITE_ID=
#MATOMO_TOKEN=

# NOTE: do not set API_BASE_URL here. The script ignores it on purpose — a
# single value would point both builds at the same backend. The flavour decides.
